# Copiar como .env y completar. Vite lee estas variables al compilar:
# después de cambiarlas hay que reiniciar `npm run dev` o volver a desplegar.

# Backend
VITE_API_URL=http://127.0.0.1:8000
# Clave pública ES256 para validar los QR sin conexión (en una sola línea, con \n)
VITE_PUBLIC_KEY=

# Límites de una reserva (tienen que coincidir con los del backend)
VITE_MAX_PERSONAS=10
VITE_MAX_NOCHES=10

# Datos del camping que muestra la web de reservas. Los vacíos no se muestran.
VITE_CAMPING_NOMBRE=Camping El Refugio
VITE_CAMPING_EMAIL=
VITE_CAMPING_TELEFONO=
VITE_CAMPING_DIRECCION=
# Un horario por franja, separados por "|"
VITE_CAMPING_HORARIOS=Lunes a sábados de 8:00 a 20:00|Domingos y feriados de 8:00 a 22:30
VITE_CAMPING_INSTAGRAM=
VITE_CAMPING_FACEBOOK=
