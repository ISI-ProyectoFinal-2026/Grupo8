# ==========================================
# SGIC - Variables de Entorno (Plantilla)
# ==========================================

# --- Base de Datos ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=sgic_db
POSTGRES_PORT=5432

# --- Entorno ("development" | "production") ---
# En "production" se deshabilita GET /usuarios/prueba
ENVIRONMENT=development

# --- URL de conexión ---
DATABASE_URL="postgresql://postgres:root@localhost:5432/sgic_db"

# --- Claves Criptográficas (ES256) ---
#Ejecutar 'python security/generate_keys.py' para autocompletar esto localmente
JWT_PRIVATE_KEY="reemplazar_con_clave_privada"
VITE_PUBLIC_KEY="reemplazar_con_clave_publica"

# --- Autenticación Web (Login) ---
AUTH_SECRET_KEY="clave_super_secreta_de_desarrollo_qamp_2026!"
# Duración del token: socios y administradores (minutos) / guardia (horas)
AUTH_TOKEN_EXPIRE_MINUTES=60
GUARD_TOKEN_EXPIRE_HOURS=168

# --- Reglas de Negocio ---
CAMPING_ID=CAMP-MENDOZA-01
# Cupo, buffer y máximo por reserva: valores iniciales. Después se editan desde el panel (Configuración)
CAMPING_TOTAL_CAPACITY=50
# Porcentaje del cupo reservado para los ingresos en la puerta (20 % = 10 lugares sobre 50)
CAMPING_PORCENTAJE_BUFFER_OFFLINE=20
MAX_PERSONAS_POR_RESERVA=10
MAX_NOCHES_POR_RESERVA=10
RESERVA_PENDIENTE_TTL_MINUTES=10
# Cancelación: hasta cuántos días antes del ingreso se puede cancelar (0 = hasta el mismo día) y porcentaje que se devuelve.
# Valores iniciales; después se editan desde el panel (Configuración)
CAMPING_DIAS_CANCELACION=1
CAMPING_PORCENTAJE_DEVOLUCION=100

# --- Configuración de Tarifas ---
PRECIO_BASE_POR_PERSONA=5000.0
PORCENTAJE_DESCUENTO_SOCIO=0.20

# --- Integraciones Cloud ---
RESEND_API_KEY="re_123456789_clave_de_prueba"

# --- Pasarela de Pagos (Mercado Pago) ---
MERCADOPAGO_ACCESS_TOKEN=pegar_token_aqui
MERCADOPAGO_PUBLIC_KEY=pegar_public_key_aqui
MERCADOPAGO_WEBHOOK_SECRET=pegar_clave_secreta_aqui # Clave secreta para validar la firma (x-signature) de los avisos

# --- Direcciones públicas (Mercado Pago) ---
# Web a la que vuelve el cliente después de pagar. En producción, la URL publicada del frontend.
FRONTEND_URL=http://localhost:5173
# Dirección del backend a la que Mercado Pago envía los avisos de pago (webhook).
# En local no llegan avisos: con localhost no se envía notification_url y el pago se confirma con "Verificar pago".
# En producción, la URL https publicada del backend (o un túnel tipo ngrok para probar en local).
BACKEND_PUBLIC_URL=http://localhost:8000
